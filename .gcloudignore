# Ignore Git files
.git
.gitignore

# Ignore node modules (will be installed on VM)
node_modules/

# Ignore local environment files
.env
.env.local
.env.production
.env.*
!.env.example

# Ignore credentials
*service-account*.json
firebase-adminsdk-*.json

# Ignore deployment scripts, docs, and internal reports (not needed on the server)
*.ps1
*.md
*.pdf
*.txt
.claude/

# Ignore logs
logs/
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/

# Ignore saved permissions files (project-specific data)
*_folder_permissions.json

# Ignore user data
user_permissions_import.json
